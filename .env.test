# Internet (non-airgapped) test build values.
# Used to build clearml/clearml:2026-06-21 from public registries/mirrors.
#   docker compose --env-file .env.test -f docker-compose.airgap.yml build

# Final image tag produced by the build.
AIRGAP_IMAGE_TAG=clearml/clearml:2026-06-21

# Public base images from Docker Hub.
# Bullseye-based python is used here so the default Debian apt repos
# (deb.debian.org) are reachable over the internet without a mirror.
WEBAPP_BUILDER_IMAGE=node:20-bullseye-slim
PYTHON_RUNTIME_IMAGE=python:3.11-slim-bullseye

# No apt mirror over the internet: leave empty to keep the image's default
# Debian sources (deb.debian.org), which are reachable online.
APT_MIRROR_URL=
APT_SECURITY_MIRROR_URL=

# Public pip index.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=pypi.org

# Public npm registry.
NPM_REGISTRY_URL=https://registry.npmjs.org/
NPM_STRICT_SSL=true

# No custom CA needed over the public internet.
AIRGAP_CA_CERT_B64=
