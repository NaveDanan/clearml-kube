# Copy to ".env" and fill in your internal registry/mirror values.
# Docker Compose auto-loads ".env" for `docker compose -f docker-compose.airgap.yml build`.

# Final image tag produced by the build.
AIRGAP_IMAGE_TAG=clearml/clearml:airgap

# Base images pulled from your internal registry mirror.
# PYTHON_RUNTIME_IMAGE MUST be Ubuntu jammy (22.04) based to match the apt mirror.
WEBAPP_BUILDER_IMAGE=dvd12af.rafael.local:5113/node:20-bookworm-slim
PYTHON_RUNTIME_IMAGE=dvd12af.rafael.local:5113/python:3.11-jammy

# Internal Ubuntu (jammy) apt mirror. Fill in manually.
# Example: https://artifactory.rafael.co.il/artifactory/ubuntu
APT_MIRROR_URL=
# Leave empty to reuse APT_MIRROR_URL for security packages.
APT_SECURITY_MIRROR_URL=

# Internal pip index.
PIP_INDEX_URL=https://artifactory.rafael.co.il/artifactory/api/pypi/pypi/simple
PIP_TRUSTED_HOST=artifactory.rafael.co.il

# Internal npm registry.
NPM_REGISTRY_URL=https://artifactory.rafael.co.il/artifactory/api/npm/npm/
NPM_STRICT_SSL=true

# Base64 of your internal CA cert (PEM). Generate with:
#   $caB64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes("artifactory.rafael.co.il.crt"))
# then paste the value here.
AIRGAP_CA_CERT_B64=
